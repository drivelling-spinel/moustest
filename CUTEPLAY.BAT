@ECHO OFF
SET GAMENAME=HERETIC
SET CUTEPARM=-w
REM SET GAMENAME=DOOM2
REM SET CUTEPARM=-d
SET CLEANUP=Y
ECHO %1 > TEMPRESP
ECHO %2 >> TEMPRESP
ECHO %3 >> TEMPRESP
ECHO %4 >> TEMPRESP
ECHO %5 >> TEMPRESP
ECHO %6 >> TEMPRESP
ECHO %7 >> TEMPRESP
ECHO %8 >> TEMPRESP
ECHO %9 >> TEMPRESP
TYPE TEMPRESP | CUTEHT %CUTEPARM% -k > CUTERESP
%GAMENAME% @CUTERESP
IF EXIST KILLTSR.BAT CALL KILLTSR.BAT
IF NOT YY==Y%CLEANUP% GOTO DONE
DEL KILLTSR.BAT
DEL TEMPRESP
DEL CUTERESP
:DONE

