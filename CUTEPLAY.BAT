@ECHO OFF
SET CUTEPARM=-w
SET CLEANUP=Y
ECHO %1 > TEMPRESP
ECHO %2 >> TEMPRESP
ECHO %3 >> TEMPRESP
ECHO %4 >> TEMPRESP
ECHO %5 >> TEMPRESP
ECHO %6 >> TEMPRESP
ECHO %7 >> TEMPRESP
ECHO %8 >> TEMPRESP
ECHO %9 >> TEMPRESP
TYPE TEMPRESP | CUTEHT %CUTEPARM% -k > CUTERESP
HERETIC @CUTERESP
IF EXIST KILLTSR.BAT CALL KILLTSR.BAT
IF NOT YY==Y%CLEANUP% GOTO DONE
DEL KILLTSR.BAT
DEL TEMPRESP
DEL CUTERESP
:DONE

