@ECHO OFF
SET GAMENAME=HERETIC
SET MULT=2
SET CUTEPARM=-m%MULT% -w -n
SET CLEANUP=Y

IF NOT EXIST JPATCHT.EXE GOTO ERROR
IF NOT EXIST SMOOTH%MULT%.DIF GOTO ERROR
IF NOT EXIST CUTEHT.EXE GOTO ERROR

ECHO %1 > TEMPRESP
ECHO %2 >> TEMPRESP
ECHO %3 >> TEMPRESP
ECHO %4 >> TEMPRESP
ECHO %5 >> TEMPRESP
ECHO %6 >> TEMPRESP
ECHO %7 >> TEMPRESP
ECHO %8 >> TEMPRESP
ECHO %9 >> TEMPRESP
TYPE TEMPRESP | CUTEHT %CUTEPARM% -k > CUTERESP

JPATCHT %GAMENAME%.EXE SMOOTH%MULT%.DIF SMOOTMP.EXE
SMOOTMP.EXE @CUTERESP
IF EXIST KILLTSR.BAT CALL KILLTSR.BAT
IF NOT YY==Y%CLEANUP% GOTO DONE
DEL SMOOTMP.EXE
DEL KILLTSR.BAT
DEL TEMPRESP
DEL CUTERESP
GOTO DONE

:ERROR
ECHO Some of the prerequisites were not found in current directory.
ECHO Please make sure that JPATCHT.EXE, CUTEHT.EXE and SMOOTH%MULT%.DIF are all present.
GOTO DONE

:DONE

